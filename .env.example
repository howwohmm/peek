# livekit credentials — generate via `docker compose run livekit livekit-server generate-keys`
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevse
# server-side url (used by next.js api routes to mint tokens)
LIVEKIT_URL=ws://localhost:7880
# client-side url (sent to browsers — must be reachable from the user's network)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
